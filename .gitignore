# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments (never commit these) ---
.venv/
venv/
env/
ENV/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Simulation outputs -------------------------------------------------
# Results are regenerated by `python run_simulation.py`. The folder structure
# is kept in the repo via .gitkeep files so the script can write into it.
results/*.csv
results/*.json
results/figures/png/*.png
results/figures/pdf/*.pdf
!.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets (nothing here uses them, but never commit them) ---
.env
*.pem
*.key
secrets.*
